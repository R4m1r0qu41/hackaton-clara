# Configurar estos valores en .env (no subir .env a Git).
DATABASE_URL=

# Endpoint solo para embeddings; no se conecta a un LLM.
# Contrato: POST {"texts":["..."]} -> {"embeddings":[[0.1,...],...]}
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_TIMEOUT_MS=30000

# Corpus PDF, rutas relativas a la raíz del repositorio.
PDF_DIR=./data/pdfs
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5

# API que n8n consume. Usa una clave generada fuera del repositorio.
RAG_API_KEY=
HOST=127.0.0.1
PORT=3000
PGCONNECT_TIMEOUT_MS=5000
