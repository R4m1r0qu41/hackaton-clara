# Docker Compose PostgreSQL settings. Fill the password; do not commit .env.
POSTGRES_DB=financial_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# For Docker Compose, use host "db" and the same database/user/password above.
# URL-encode special characters in the password.
DATABASE_URL=

# Endpoint only for embeddings. No LLM provider is selected here.
# Contract: POST {"texts":["..."]} -> {"embeddings":[[0.1,...],...]}
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_TIMEOUT_MS=30000

PDF_DIR=./data/pdfs
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5

# Generate this key yourself and store it in .env.
RAG_API_KEY=
HOST=127.0.0.1
PORT=3000
PGCONNECT_TIMEOUT_MS=5000
