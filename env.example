# PostgreSQL local (ajustar cuando configuremos Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_rag

# Endpoint HTTP de embeddings. Debe aceptar {"texts":["..."]}
# y devolver {"embeddings":[[0.1, ...], ...]} en el mismo orden.
# Puede ser un endpoint propio o uno que expongamos desde n8n.
EMBEDDINGS_API_URL=
EMBEDDINGS_API_KEY=

# Ingesta
PDF_DIR=./data/pdfs
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Recuperación
TOP_K=5
